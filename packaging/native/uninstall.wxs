<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="OxboxNativeUninstallCleanupMarker" Guid="111EF58D-8190-5B03-B5B5-27E417EE125D" Win64="yes">
        <CreateFolder />
      </Component>
    </DirectoryRef>
    <CustomAction Id="OxboxNativeUninstallCleanup" FileKey="Path" ExeCommand="--uninstall-cleanup" Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="OxboxNativeUninstallCleanup" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
